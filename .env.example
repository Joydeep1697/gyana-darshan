# ── Nyaya Darshan — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control — it is listed in .gitignore.

# ── LLM Configuration ─────────────────────────────────────────────
# NVIDIA NIM (cloud API)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY
NVIDIA_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
LEGAL_REQUEST_TIMEOUT=75
LEGAL_MODEL_TIMEOUT=60
LEGAL_MAX_TOKENS=320
LEGAL_CACHE_TTL_SECONDS=300
LEGAL_MAX_CONCURRENCY=4
LEGAL_MAX_RETRIES=2

# ── Authentication ────────────────────────────────────────────────
# Required for production. If unset, the API is completely open.
NYAYA_API_KEY=REPLACE_WITH_A_STRONG_SECRET_KEY
# Required for production; use a unique secret with at least 32 characters.
NYAYA_JWT_SECRET=REPLACE_WITH_A_UNIQUE_SECRET_AT_LEAST_32_CHARACTERS_LONG
# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only for local dev.
ALLOWED_ORIGINS=https://nyayadarshana.com,https://www.nyayadarshana.com

# ── Payment Gateway ───────────────────────────────────────────────
# Razorpay credentials — use TEST keys for staging, LIVE keys for production.
RAZORPAY_KEY_ID=REPLACE_WITH_YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_RAZORPAY_KEY_SECRET
# Leave both Razorpay values empty when billing is intentionally disabled.

# ── Paths ─────────────────────────────────────────────────────────
# All paths default to relative locations under Indian Legal/
# Uncomment and change only if your layout differs.
# INDIAN_LEGAL_DIR=/opt/nyaya-darshan/Indian Legal
# RAW_DIR=/opt/nyaya-darshan/Indian Legal/raw
# CORPUS_DIR=/opt/nyaya-darshan/Indian Legal/processed_corpus
# INDEX_DIR=/opt/nyaya-darshan/Indian Legal/nova_rag_index
# CATEGORY_DIR=/opt/nyaya-darshan/Indian Legal/Category
# NYAYA_DATA_DIR=/var/lib/nyaya-darshan
# NYAYA_LOG_DIR=/var/log/nyaya-darshan
# Query text is redacted from audit logs by default. Enable only when necessary.
# NYAYA_LOG_QUERY_TEXT=false
# WEB_CONCURRENCY=1
# FORWARDED_ALLOW_IPS=127.0.0.1

# ── OCR (optional) ───────────────────────────────────────────────
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANGUAGE=eng

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
