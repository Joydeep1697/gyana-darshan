# ── Nova Legal OS — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control — it is listed in .gitignore.

# ── LLM Configuration ─────────────────────────────────────────────
# Option A: NVIDIA NIM (cloud API — production default)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY
NVIDIA_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# Option B: Local Ollama (development only)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=novelaw

# ── Authentication ────────────────────────────────────────────────
# Required for production. If unset, the API is completely open.
NYAYA_API_KEY=REPLACE_WITH_A_STRONG_SECRET_KEY

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only for local dev.
ALLOWED_ORIGINS=https://nyayadarshana.com,https://www.nyayadarshana.com

# ── Payment Gateway ───────────────────────────────────────────────
# Razorpay credentials — use TEST keys for staging, LIVE keys for production.
RAZORPAY_KEY_ID=REPLACE_WITH_YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_RAZORPAY_KEY_SECRET

# ── Paths ─────────────────────────────────────────────────────────
# All paths default to relative locations under Indian Legal/
# Uncomment and change only if your layout differs.
# INDIAN_LEGAL_DIR=D:\Nova Legal\Indian Legal
# RAW_DIR=D:\Nova Legal\Indian Legal\raw
# CORPUS_DIR=D:\Nova Legal\Indian Legal\processed_corpus
# INDEX_DIR=D:\Nova Legal\Indian Legal\nova_rag_index
# CATEGORY_DIR=D:\Nova Legal\Indian Legal\Category

# ── OCR (optional) ───────────────────────────────────────────────
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANGUAGE=eng

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
